{
  "uid": "streams-lysenko",
  "title": "ЛР4 · Streams і Saga · Лисенко · 3Б",
  "panels": [
    {
      "id": 1,
      "title": "Перевірені вікна останнього Streams тесту",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "hydro-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hydro_stream_windows_verified",
          "legendFormat": "{{station}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
